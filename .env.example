# Copy this file to .env and fill in real values.
# .env should be in .gitignore — never commit real secrets.

WIKIJS_DB_PASSWORD=changeme

SNIPEIT_DB_PASSWORD=changeme
SNIPEIT_DB_ROOT_PASSWORD=changeme
# Generate with: docker run --rm snipe/snipe-it php artisan key:generate --show
SNIPEIT_APP_KEY=base64:changeme
